{
  "rules": {
    ".read": false,
    ".write": false,
    "grim": {
      "rooms": {
        "$roomId": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === 'REPLACE_WITH_YOUR_DM_ANONYMOUS_UID'",
          ".validate": "newData.hasChildren(['mode', 'sceneId', 'characters'])"
        }
      }
    }
  }
}
