{
  "auth": {
    "providers": {
      "anonymous": true
    }
  },
  "database": {
    "rules": "firebase-rtdb.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/docs/**",
      "tests/**",
      "assets/music/**",
      "**/*REPORT*.md",
      "**/*CHANGELOG*.md",
      "**/*.bat",
      "server.js",
      "README.md",
      "qa/**",
      "tools/**",
      "RELEASES/**",
      "qa-reports/**",
      "legacy/tests/**",
      "*.md",
      "package.json",
      "firebase-rtdb.rules.json"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      }
    ]
  }
}